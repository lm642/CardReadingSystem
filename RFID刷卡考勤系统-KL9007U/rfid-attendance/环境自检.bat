@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
title RFID 项目 环境自检

echo ============================================================
echo   RFID 签到系统  运行环境自检
echo ============================================================
echo.
echo 本工具会把你电脑上每个 Python 解释器都检查一遍，告诉你：
echo   * 程序实际用的是哪一个 Python
echo   * 串口库 pyserial 到底装在哪个 Python 里
echo   * 系统当前有哪些串口（找 COM 号）
echo.
echo ------------------------------------------------------------
echo [1] 项目自带依赖 _vendor
echo ------------------------------------------------------------
if exist "_vendor\serial\__init__.py" (
    echo    OK  _vendor\serial 存在 —— 内置 pyserial 可用，任何 Python 都能跑
) else (
    echo    缺失！请确认整个项目是"完整解压"出来的，
    echo          目录下必须有 _vendor\serial 文件夹。
)
echo.

echo ------------------------------------------------------------
echo [2] 各个 Python 解释器的检查结果
echo ------------------------------------------------------------
for %%A in ("py -3.14" "py -3.13" "py -3.12" "py -3.11" "py -3.10" "python") do (
    %%~A -c "import sys" >nul 2>nul
    if not errorlevel 1 (
        echo   ^>^>^> %%A
        %%~A env_check.py
    )
)

echo.
echo ------------------------------------------------------------
echo [3] py 启动器登记的所有 Python
echo ------------------------------------------------------------
py -0p 2>nul || echo    （没有 py 启动器，可忽略）

echo.
echo ------------------------------------------------------------
echo 把上面整屏内容截图发给老师/同学，就能定位问题。
echo ------------------------------------------------------------
pause
